<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Blogs | Blogify</title>

  <style>
    /* ===== GLOBAL LAYOUT FIX ===== */
    body {
      background: #f8fafc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .page-wrapper {
      flex: 1;
      padding-bottom: 60px;
    }

    /* ===== MAX WIDTH CONTROL (KEY FIX) ===== */
    .blog-container {
      max-width: 1800px; /* controls density */
      margin: auto;
      padding: 0 16px;
    }

    /* ===== HEADER ===== */
    .blogs-header h2 {
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 18px;
    }

    /* ===== CATEGORY BAR ===== */
    .category-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 32px;
    }

    .category-pill {
      padding: 6px 16px;
      border-radius: 999px;
      background: #e5e7eb;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    .category-pill.active {
      background: #2563eb;
      color: #fff;
    }

    /* ===== BLOG CARD ===== */
    .blog-card {
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 12px 28px rgba(0,0,0,0.08);
      height: 100%;
      display: flex;
      flex-direction: column;
      transition: transform .15s ease;
    }

    .blog-card:hover {
      transform: translateY(-4px);
    }

    .blog-image {
      width: 100%;
      height: 230px;
      object-fit: cover;
    }

    .blog-body {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .blog-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 6px;
    }

    .blog-desc {
      font-size: 14px;
      color: #475569;
      line-height: 1.6;
      max-height: 64px;
      overflow: hidden;
      margin-bottom: 14px;
    }

    .blog-divider {
      height: 1px;
      background: #e5e7eb;
      margin: 12px 0;
    }

    .blog-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      gap: 10px;
    }

    .author-info {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #475569;
      max-width: 75%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .author-info img {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      object-fit: cover;
    }

    .read-btn {
      font-size: 13px;
      font-weight: 600;
      padding: 6px 16px;
      white-space: nowrap;
    }
  </style>
</head>

<body>

<%- include('./partials/nav') %>

<div class="page-wrapper">
  <div class="container-fluid mt-4">
    <div class="blog-container">

      <!-- HEADER -->
      <div class="blogs-header">
        <h2>Latest Blog Posts</h2>
      </div>

      <!-- CATEGORY BAR -->
      <div class="category-bar">
        <div class="category-pill active">All</div>
        <div class="category-pill">Tech</div>
        <div class="category-pill">Lifestyle</div>
        <div class="category-pill">AI</div>
        <div class="category-pill">Coding</div>
        <div class="category-pill">Travel</div>
      </div>

      <!-- BLOG GRID -->
      <div class="row g-4">

        <% blogs.forEach(blog => { %>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="blog-card">

              <!-- IMAGE -->
              <img
                src="<%= blog.coverImageURL %>"
                class="blog-image"
                alt="Blog cover"
              >

              <div class="blog-body">

                <!-- TITLE -->
                <div class="blog-title">
                  <%= blog.title %>
                </div>

                <!-- DESCRIPTION -->
                <div class="blog-desc">
                  <%= blog.content?.blocks?.find(b => b.type === "paragraph")?.data?.text || "" %>
                </div>

                <!-- DIVIDER -->
                <div class="blog-divider"></div>

                <!-- FOOTER -->
                <div class="blog-footer">

                  <!-- AUTHOR -->
                  <div class="author-info">
                    <img src="<%= blog.CREATED_BY?.profileImageURL || '/image/default.png' %>">
                    <span>
                      <%= blog.CREATED_BY?.fullName %> ·
                      <%= blog.createdAt.toDateString() %>
                    </span>
                  </div>

                  <!-- READ MORE -->
                  <a
                    href="/blog/<%= blog._id %>"
                    class="btn btn-primary btn-sm read-btn"
                  >
                    Read More
                  </a>

                </div>
              </div>

            </div>
          </div>
        <% }) %>

      </div>

    </div>
  </div>
</div>

<%- include('./partials/footer') %>
<%- include('./partials/script') %>

</body>
</html>