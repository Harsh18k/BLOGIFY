<style>
    /* ===============================
       PAGE-SPECIFIC STYLES
    =============================== */
  
    html, body {
      height: 100%;
    }
  
    body {
      background: #f8fafc;
      margin: 0;
      display: flex;
      flex-direction: column;
      font-family: system-ui, -apple-system, BlinkMacSystemFont,
                   "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #111827;
    }
  
    .page-wrapper {
      flex: 1;
      padding-bottom: 72px;
    }
  
    .blog-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }
  
    .blogs-header {
      margin-bottom: 20px;
    }
  
    .blogs-header h2 {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.3px;
      margin: 0;
    }
  
    .category-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 36px;
    }
  
    .category-pill {
      padding: 6px 16px;
      font-size: 14px;
      font-weight: 600;
      border-radius: 999px;
      background: #e5e7eb;
      color: #111827;
      cursor: pointer;
    }
  
    .category-pill.active {
      background: #111827;
      color: #ffffff;
    }
  
    .blog-list {
      display: flex;
      flex-direction: column;
    }
  
    .blog-card {
      position: relative;
      display: flex;
      gap: 28px;
      padding: 28px 0;
      align-items: flex-start;
    }
  
    .blog-card .card-link {
      position: absolute;
      inset: 0;
      z-index: 1;
      padding-bottom: 28px;
      border-bottom: 1px solid #e5e7eb;
    }
  
    .blog-body,
    .blog-image {
      position: relative;
      z-index: 2;
    }
  
    .blog-body {
      flex: 1;
      max-width: 680px;
    }
  
    .author-info {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      margin-bottom: 6px;
    }
  
    .author-info img {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
    }
  
    .blog-title {
      font-size: 24px;
      font-weight: 800;
      margin-bottom: 6px;
    }
  
    .blog-desc {
      font-size: 16px;
      line-height: 1.6;
      color: #4b5563;
      margin-bottom: 14px;
  
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  
    .blog-footer {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 13px;
      color: #6b7280;
    }
  
    .blog-image {
      width: 120px;
      height: 120px;
      border-radius: 6px;
      object-fit: cover;
    }
  </style>
  
  <div class="page-wrapper">
    <div class="container-fluid mt-4">
      <div class="blog-container">
  
        <div class="blogs-header">
          <h2>Latest Blog Posts</h2>
        </div>
  
        <div class="category-bar">
          <div class="category-pill active">All</div>
          <div class="category-pill">Tech</div>
          <div class="category-pill">Lifestyle</div>
          <div class="category-pill">AI</div>
          <div class="category-pill">Coding</div>
          <div class="category-pill">Travel</div>
        </div>
  
        <div class="blog-list">
          <% blogs.forEach(blog => { %>
            <article class="blog-card">
              <a href="/blog/<%= blog._id %>" class="card-link"></a>
  
              <div class="blog-body">
                <div class="author-info">
                  <img src="<%= blog.CREATED_BY?.profileImageURL || '/image/default.png' %>">
                  <span><%= blog.CREATED_BY?.fullName %></span>
                </div>
  
                <div class="blog-title"><%= blog.title %></div>
  
                <div class="blog-desc">
                  <%= (blog.content?.blocks?.find(b => b.type === "paragraph")?.data?.text) || "" %>
                </div>
  
                <div class="blog-footer">
                  <span><%= new Date(blog.createdAt).toDateString() %></span>
                  <span>👁 1.6K</span>
                  <span>💬 33</span>
                </div>
              </div>
  
              <img src="<%= blog.coverImageURL %>" class="blog-image">
            </article>
          <% }) %>
        </div>
  
      </div>
    </div>
  </div>
  