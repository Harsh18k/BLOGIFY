<style>
    body {
      background: #f8fafc;
      color: #0f172a;
    }
  
    /* ================= LAYOUT ================= */
    .section {
      padding: 96px 20px;
    }
  
    .container-narrow {
      max-width: 1100px;
      margin: auto;
    }
  
    .container-wide {
      max-width: 1300px;
      margin: auto;
    }
  
    /* ================= HERO ================= */
    .hero {
      padding: 120px 20px 80px;
      text-align: center;
      background:
        linear-gradient(
          rgba(248,250,252,0.94),
          rgba(248,250,252,0.94)
        ),
        url("/image/hero-bg.png");
      background-size: cover;
      background-position: center;
      position: relative;
      overflow: hidden;
    }
  
    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        800px 300px at top center,
        rgba(79, 70, 229, 0.12),
        transparent
      );
      pointer-events: none;
    }
  
    .hero h1 {
      font-size: 4rem;
      font-weight: 900;
      letter-spacing: -1px;
      line-height: 1.15;
    }
  
    .hero h1 span {
      color: #4f46e5;
    }
  
    .hero p {
      margin: 24px auto 0;
      max-width: 720px;
      font-size: 1.25rem;
      line-height: 1.8;
      color: #475569;
    }
  
    .hero-actions {
      margin-top: 40px;
    }
  
    .hero-actions a {
      margin: 8px;
      padding: 16px 34px;
      border-radius: 14px;
      font-size: 1.05rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }
  
    .hero-actions a.btn-primary {
      background: linear-gradient(135deg, #4f46e5, #6366f1);
      border: none;
      box-shadow: 0 12px 30px rgba(79, 70, 229, 0.25);
    }
  
    .hero-actions a.btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 36px rgba(79, 70, 229, 0.35);
    }
  
    /* ================= VALUE STRIP ================= */
    .value-strip {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 32px;
      margin-top: 96px;
    }
  
    .value {
      background: #ffffff;
      border-radius: 18px;
      padding: 28px 24px;
      text-align: center;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
  
    .value:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
    }
  
    .value h4 {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
    }
  
    .value p {
      color: #64748b;
      font-size: 15px;
      line-height: 1.6;
    }
  
    /* ================= FEATURES ================= */
    .features {
      background: #ffffff;
      position: relative;
    }
  
    .features h2 {
      font-size: 2.6rem;
      font-weight: 900;
      text-align: center;
      margin-bottom: 64px;
    }
  
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 32px;
    }
  
    .feature-card {
      background: #f8fafc;
      border-radius: 18px;
      padding: 32px;
      height: 100%;
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
  
    .feature-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 48px rgba(15, 23, 42, 0.12);
    }
  
    .feature-card h4 {
      font-weight: 800;
      margin-bottom: 10px;
    }
  
    .feature-card p {
      color: #475569;
      font-size: 15px;
      line-height: 1.7;
    }
  
    /* ================= FUTURE ================= */
    .future {
      text-align: center;
    }
  
    .future h2 {
      font-size: 2.6rem;
      font-weight: 900;
    }
  
    .future p {
      max-width: 720px;
      margin: 20px auto 0;
      font-size: 1.15rem;
      color: #475569;
    }
  
    .future-tags {
      margin-top: 40px;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }
  
    .future-tags span {
      padding: 10px 16px;
      background: #eef2ff;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      color: #4338ca;
      transition: all 0.15s ease;
    }
  
    .future-tags span:hover {
      background: #4f46e5;
      color: #ffffff;
      transform: translateY(-2px);
    }
  
    /* ================= CTA ================= */
    .cta {
      background: linear-gradient(135deg, #0f172a, #020617);
      color: #ffffff;
      text-align: center;
      position: relative;
    }
  
    .cta::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        600px 200px at center top,
        rgba(99, 102, 241, 0.25),
        transparent
      );
      pointer-events: none;
    }
  
    .cta h2 {
      font-size: 3rem;
      font-weight: 900;
    }
  
    .cta p {
      max-width: 680px;
      margin: 20px auto;
      font-size: 1.15rem;
      color: #c7d2fe;
    }
  
    .cta a {
      padding: 16px 36px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1.05rem;
      box-shadow: 0 10px 30px rgba(255, 255, 255, 0.15);
      transition: all 0.2s ease;
    }
  
    .cta a:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 40px rgba(255, 255, 255, 0.25);
    }
  
    /* ================= RESPONSIVE ================= */
    @media (max-width: 992px) {
      .hero h1 {
        font-size: 3rem;
      }
  
      .value-strip,
      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
  
  <section class="hero">
    <div class="container-narrow">
      <h1>A modern platform for <span>writing & publishing</span></h1>
      <p>
        Blogify helps creators write clean blogs, publish effortlessly,
        and grow with premium tools — without clutter.
      </p>
  
      <div class="hero-actions">
        <a href="/blogs" class="btn btn-primary btn-lg">Explore Blogs</a>
  
        <% if (user) { %>
          <a href="/blog/add-new" class="btn btn-outline-dark btn-lg">Write a Blog</a>
        <% } else { %>
          <a href="/user/signin" class="btn btn-outline-dark btn-lg">Get Started</a>
        <% } %>
      </div>
  
      <div class="value-strip">
        <div class="value">
          <i class="fa-solid fa-pencil fs-3 text-primary mb-2"></i>
          <h4>Writing Experience</h4>
          <p>Editor.js powered writing experience focused on clarity.</p>
        </div>
        <div class="value">
          <i class="fa-solid fa-coins fs-3 text-primary mb-2"></i>
          <h4>Built-in Monetization</h4>
          <p>Subscriptions, payments & invoices built-in.</p>
        </div>
        <div class="value">
          <i class="fa-solid fa-envelope-circle-check fs-3 text-primary mb-2"></i>
          <h4>Reliable Communication</h4>
          <p>OTPs, payment alerts & account emails handled reliably.</p>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section features">
    <div class="container-wide">
      <h2>Built for creators, not clutter</h2>
  
      <div class="feature-grid">
        <div class="feature-card">
          <i class="fa-solid fa-layer-group fs-4 text-primary mb-3"></i>
          <h4>Editor.js Content</h4>
          <p>
            Structured, block-based content that renders beautifully
            on all devices.
          </p>
        </div>
  
        <div class="feature-card">
          <i class="fa-solid fa-shield-halved fs-4 text-primary mb-3"></i>
          <h4>Authentication & Security</h4>
          <p>
            Google OAuth, OTP verification, secure sessions and roles.
          </p>
        </div>
  
        <div class="feature-card">
          <i class="fa-solid fa-credit-card fs-4 text-primary mb-3"></i>
          <h4>Payments & Invoices</h4>
          <p>
            Razorpay powered subscriptions with automated invoices.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section future">
    <div class="container-narrow">
      <h2>Designed to grow with you</h2>
      <p>
        Blogify is evolving — built today for features you’ll need tomorrow.
      </p>
  
      <div class="future-tags">
        <span><i class="fa-solid fa-wand-magic-sparkles me-1"></i> AI Writing Assist</span>
        <span><i class="fa-solid fa-chart-line me-1"></i> Creator Analytics</span>
        <span><i class="fa-solid fa-code me-1"></i> Public API</span>
        <span><i class="fa-solid fa-globe me-1"></i> Custom Domains</span>
        <span><i class="fa-solid fa-users me-1"></i> Teams & Collaboration</span>
      </div>
    </div>
  </section>
  
  <section class="section cta">
    <div class="container-narrow">
      <i class="fa-solid fa-feather-pointed me-2"></i>
      <h2>Start writing with confidence</h2>
      <p>
        No noise. No distractions. Just a platform that respects creators.
      </p>
  
      <a href="/user/signin" class="btn btn-light btn-lg mt-3">
        Join Blogify
      </a>
    </div>
  </section>